# Normalise line endings: LF in the repository, native in working copies.
# Without this, committing from Windows records CRLF and every diff on Linux/macOS
# shows the whole file as changed.
* text=auto eol=lf

# Notebooks are JSON - keep them LF so diffs stay readable.
*.ipynb text eol=lf

# Never let git touch binaries.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.pt   binary
*.onnx binary
*.db   binary
